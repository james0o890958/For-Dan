# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# SUPABASE (Server-side configuration only; never expose service role or DB credentials to browser)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-supabase-publishable-or-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
DATABASE_URL="postgresql://postgres.your-project-ref:YOUR-PASSWORD@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"

# SECURITY & IP INTELLIGENCE (Server-side only; never expose API keys to browser)
IP_GEOLOCATION_API_KEY="your-ipgeolocation-api-key"
TRUSTED_PROXY_HOPS="1"
